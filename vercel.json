{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.3"
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/api/index.php"
        }
    ],
    "headers": [
        {
            "source": "/(css|js|images|fonts|build)/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public,max-age=31536000,immutable"
                }
            ]
        }
    ],
    "outputDirectory": "public"
}
